# kbwb 环境配置示例
# 复制为 .env 后按需修改。留空的项为凭据，需自行填写。
# 每个变量对应 src/kbwb/config/settings.py 中的同名字段。

# ============ Provider 选型 ============
# chat 与 embedding 可独立选择供应方，按预算与数据合规要求组合。
# 可选值：openai | deepseek | local（local 仅支持 embedding）
CHAT_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# 模型名。无默认值，必须显式指定——不同供应方的模型名不通用。
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ============ 凭据 ============
# 只需填写所选 provider 对应的凭据。缺失时系统在启动阶段报错并指出变量名。
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 本地嵌入模型（EMBEDDING_PROVIDER=local 时使用）。
# 首次使用需下载权重（中文嵌入约 96MB），需安装可选依赖组：uv sync --extra local-models
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ============ 存储 ============
# 每个知识库一个子目录：<DATA_ROOT>/<kb_id>/{raw,md,index}
DATA_ROOT=data

# ============ 本地服务监听 ============
# 默认只绑回环。改为对外监听前请注意：本服务不含身份认证。
HOST=127.0.0.1
PORT=8000

# ============ 切分默认值 ============
# 建库时可被语料画像的推荐值覆盖，这里是推荐器不触发时的兜底。
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=120
CHUNK_MIN_CHARS=80

# ============ 检索默认值 ============
# 混合检索是默认而非可选优化：纯向量对文号等精确编号召回极差。
# 可选值：vector | keyword | hybrid
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_SCORE_THRESHOLD=0.3

# 精排默认关闭：权重约 1.1GB，需安装可选依赖组 local-models。
# 启用后若模型加载失败，系统会中止而非静默降级为不精排。
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base

# ============ 画像与推荐阈值 ============
# 推荐器据此触发建议。每条建议都可在界面上覆盖，这些值只影响何时提出建议。
SCANNED_RATIO_THRESHOLD=0.2
DUPLICATE_TEMPLATE_RATIO_THRESHOLD=0.3
DOC_ID_DENSITY_THRESHOLD=0.1
MIN_BODY_CHARS=50

# ============ 站点结构探测 ============
# 探测的意义在于比全站爬取便宜一个数量级：先摸清站点有什么、多大，
# 再决定爬哪些。预算达到上限时探测中止并报告未探测的栏目，不会静默截断。
PROBE_REQUEST_BUDGET=60

# 每个页面模板采样几个页面用于分区与抽取推断。
# 注意采样单位是模板不是栏目——多个栏目共用同一模板时只采样一次。
SAMPLES_PER_TEMPLATE=3

# 页面模板聚类的结构相似度阈值。调高则模板分得更细，调低则更容易合并。
TEMPLATE_SIMILARITY_THRESHOLD=0.7

# 分区识别的置信度阈值。低于此值的分区在界面上标为不可靠，供人工确认。
REGION_CONFIDENCE_THRESHOLD=0.5

# ============ 运行时限制 ============
MAX_INPUT_CHARS=4000
RATE_LIMIT_PER_MINUTE=30

# ============ Provider 失败处理 ============
# 限流/超时/5xx 按此退避重试；重试耗尽后返回可区分的错误，不会返回空结果冒充成功。
PROVIDER_MAX_RETRIES=3
PROVIDER_BACKOFF_SECONDS=1.0
